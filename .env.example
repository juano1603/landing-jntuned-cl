# Plantilla. Copiar a `.env.local` para desarrollo y cargar las mismas
# variables en Vercel → Settings → Environment Variables.

# --- Sitio -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp en formato internacional sin "+" (ej. 56912345678).
NEXT_PUBLIC_WHATSAPP=56949257974

# --- Base de datos -------------------------------------------------------------
# Desarrollo: `npm run db:up` levanta Postgres en Docker con estas credenciales.
# Producción (Neon): DATABASE_URL con pooler; DIRECT_URL sin pooler (migraciones).
DATABASE_URL="postgresql://jntuned:jntuned@localhost:5439/jntuned"
# DIRECT_URL=

# --- Panel /admin ----------------------------------------------------------------
# Generar con: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=true
# Solo para el primer `npm run db:seed` (pasarlas en el comando, no dejarlas aquí).
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=

# --- Fotos (Vercel Blob) -----------------------------------------------------------
# Sin token, en desarrollo las fotos se guardan en public/uploads.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
