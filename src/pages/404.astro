---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Página no encontrada | JNTUNED" noindex>
  <Header />
  <main class="flex min-h-[80svh] flex-col items-start justify-center px-4 sm:px-6 lg:px-8">
    <div class="mx-auto w-full max-w-7xl">
      <p class="font-display text-sm font-semibold uppercase tracking-[0.3em] text-electric-bright">Error 404</p>
      <h1 class="mt-2 font-display text-6xl font-bold uppercase text-white sm:text-8xl">Fuera de mapa</h1>
      <a href="/" class="mt-8 inline-block bg-electric px-7 py-3.5 font-display text-lg font-bold uppercase tracking-wider text-white hover:bg-electric-light">
        Volver al inicio
      </a>
    </div>
  </main>
  <Footer />
</Layout>
