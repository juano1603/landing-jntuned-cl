---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import SectionTitle from '../components/SectionTitle.astro';
import BuildCard from '../components/BuildCard.astro';
import Gallery from '../components/Gallery.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';
import { builds } from '../data/builds';
import { servicios } from '../data/servicios';

// Los builds con foto van como tarjeta grande; el resto, en una lista compacta debajo
const conFoto = builds.filter(b => b.foto);
const sinFoto = builds.filter(b => !b.foto);

const equipos = [
  { nombre: 'FuelTech', tipo: 'FT300 · FT450' },
  { nombre: 'HP Tuners', tipo: 'Flash y calibración' },
  { nombre: 'Tactrix', tipo: 'OpenPort 2.0' },
  { nombre: 'RaceTec', tipo: 'ECU standalone' },
  { nombre: 'TunerNerd', tipo: 'Monitor de knock' },
];
---

<Layout>
  <Header />

  <main>
    <Hero />

    <!-- BUILDS -->
    <section id="builds" class="scroll-mt-16 px-4 py-20 sm:px-6 sm:py-28 lg:px-8" aria-labelledby="builds-title">
      <div class="mx-auto max-w-7xl">
        <SectionTitle id="builds-title" kicker="Proyectos" title="Builds recientes" />
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {conFoto.map(b => <BuildCard build={b} />)}
        </div>
        {sinFoto.length > 0 && (
          <ul class="mt-3 grid grid-cols-1 gap-px bg-white/10 sm:grid-cols-2 lg:grid-cols-4">
            {sinFoto.map(b => (
              <li class="bg-ink-50 p-5">
                <p class="font-display text-xs font-semibold uppercase tracking-wider text-slate-500">{b.tag}</p>
                <h3 class="mt-1 font-display text-xl font-bold uppercase leading-tight text-white">{b.auto}</h3>
                <p class="mt-1 text-sm text-slate-400">{b.motor}</p>
                <p class="mt-2 font-display font-semibold uppercase tracking-wide text-electric-bright">{b.resultado}</p>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>

    <!-- TRABAJOS -->
    <section id="trabajos" class="scroll-mt-16 bg-ink-50 px-4 py-20 sm:px-6 sm:py-28 lg:px-8" aria-labelledby="trabajos-title">
      <div class="mx-auto max-w-7xl">
        <SectionTitle id="trabajos-title" kicker="Galería" title="Trabajos">
          <a
            href={SITE.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="font-display text-base font-semibold uppercase tracking-wider text-slate-300 transition-colors hover:text-white"
          >
            Más en Instagram →
          </a>
        </SectionTitle>
        <Gallery />
      </div>
    </section>

    <!-- SERVICIOS -->
    <section id="servicios" class="scroll-mt-16 px-4 py-20 sm:px-6 sm:py-28 lg:px-8" aria-labelledby="servicios-title">
      <div class="mx-auto max-w-7xl">
        <SectionTitle id="servicios-title" kicker="Qué hacemos" title="Servicios" />
        <div class="grid grid-cols-1 gap-px bg-white/10 sm:grid-cols-2 lg:grid-cols-4">
          {servicios.map(s => (
            <article class="group relative bg-ink p-7 transition-colors hover:bg-ink-50">
              {s.nuevo && (
                <span class="absolute right-5 top-5 bg-electric px-2.5 py-1 font-display text-xs font-bold uppercase tracking-wider text-white">
                  {typeof s.nuevo === 'string' ? s.nuevo : 'Nuevo'}
                </span>
              )}
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-electric-light" aria-hidden="true" set:html={s.icon} />
              <h3 class="mt-6 font-display text-2xl font-bold uppercase text-white">{s.titulo}</h3>
              <p class="mt-2 text-sm text-slate-400">{s.linea}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- EQUIPOS -->
    <section id="equipos" class="scroll-mt-16 border-y border-white/10 px-4 py-14 sm:px-6 lg:px-8" aria-labelledby="equipos-title">
      <div class="mx-auto max-w-7xl">
        <h2 id="equipos-title" class="mb-8 font-display text-sm font-semibold uppercase tracking-[0.3em] text-slate-500">
          Equipos con los que trabajamos
        </h2>
        <ul class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:grid-cols-5">
          {equipos.map(e => (
            <li>
              <p class="font-display text-3xl font-bold uppercase text-white">{e.nombre}</p>
              <p class="text-xs uppercase tracking-wider text-slate-500">{e.tipo}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- CONTACTO -->
    <section id="contacto" class="scroll-mt-16 px-4 py-20 sm:px-6 sm:py-28 lg:px-8" aria-labelledby="contacto-title">
      <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-10 lg:flex-row lg:items-end">
        <div>
          <p class="mb-2 font-display text-sm font-semibold uppercase tracking-[0.3em] text-electric-bright">Contacto</p>
          <h2 id="contacto-title" class="font-display text-5xl font-bold uppercase leading-[0.95] text-white sm:text-7xl">
            ¿Qué le hacemos<br />a tu auto?
          </h2>
          <p class="mt-5 text-slate-400">Temuco, Región de La Araucanía.</p>
        </div>
        <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
          <a
            href={SITE.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-electric px-8 py-4 text-center font-display text-xl font-bold uppercase tracking-wider text-white transition-colors hover:bg-electric-light"
          >
            Escríbenos por WhatsApp
          </a>
          <a
            href={SITE.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="border border-white/30 px-8 py-4 text-center font-display text-xl font-bold uppercase tracking-wider text-white transition-colors hover:border-white hover:bg-white hover:text-ink"
          >
            {SITE.instagramHandle}
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <!-- WhatsApp flotante -->
  <a
    href={SITE.whatsapp}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Contactar por WhatsApp"
    class="fixed bottom-5 right-5 z-40 flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] shadow-lg transition-transform hover:scale-105"
  >
    <svg width="28" height="28" viewBox="0 0 24 24" fill="white" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z" />
      <path d="M12 0C5.373 0 0 5.373 0 12c0 2.124.558 4.118 1.525 5.845L.057 23.428a.5.5 0 0 0 .617.601l5.763-1.511A11.943 11.943 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.882a9.875 9.875 0 0 1-5.031-1.381l-.36-.214-3.733.979.997-3.645-.234-.374A9.869 9.869 0 0 1 2.118 12C2.118 6.533 6.533 2.118 12 2.118c5.468 0 9.882 4.415 9.882 9.882 0 5.468-4.414 9.882-9.882 9.882z" />
    </svg>
  </a>
</Layout>
