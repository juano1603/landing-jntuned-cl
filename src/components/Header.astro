---
import { SITE } from '../data/site';

const navLinks = [
  { label: 'Builds', href: '#builds' },
  { label: 'Trabajos', href: '#trabajos' },
  { label: 'Servicios', href: '#servicios' },
  { label: 'Equipos', href: '#equipos' },
  { label: 'Contacto', href: '#contacto' },
];
---

<header id="header" class="fixed inset-x-0 top-0 z-50 transition-colors duration-300">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-4 sm:px-6 lg:px-8">
    <a href="/" class="flex-shrink-0" aria-label="JNTUNED inicio">
      <img src="/logo-jntuned.png" alt="JNTUNED" width="140" height="27" class="h-6 w-auto sm:h-7" />
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Navegación principal">
      {navLinks.map(link => (
        <a href={link.href} class="font-display text-[15px] font-semibold uppercase tracking-wider text-slate-300 transition-colors hover:text-white">
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={SITE.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden bg-electric px-5 py-2 font-display text-[15px] font-bold uppercase tracking-wider text-white transition-colors hover:bg-electric-light sm:inline-flex"
      >
        Cotizar
      </a>
      <button
        id="menu-toggle"
        class="flex h-10 w-10 items-center justify-center text-slate-200 md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="7" x2="21" y2="7" /><line x1="3" y1="17" x2="21" y2="17" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-white/10 bg-ink md:hidden">
    <nav class="flex flex-col px-4 py-4" aria-label="Menú móvil">
      {navLinks.map(link => (
        <a href={link.href} class="mobile-link py-3 font-display text-xl font-semibold uppercase tracking-wider text-slate-200">
          {link.label}
        </a>
      ))}
      <a
        href={SITE.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3 bg-electric py-3 text-center font-display text-lg font-bold uppercase tracking-wider text-white"
      >
        Cotizar por WhatsApp
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('header') as HTMLElement;
  const onScroll = () => {
    const solid = window.scrollY > 40;
    header.classList.toggle('bg-ink/95', solid);
    header.classList.toggle('backdrop-blur', solid);
    header.classList.toggle('border-b', solid);
    header.classList.toggle('border-white/10', solid);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const toggle = document.getElementById('menu-toggle') as HTMLButtonElement;
  const menu = document.getElementById('mobile-menu') as HTMLElement;
  const setOpen = (open: boolean) => {
    menu.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    if (open) header.classList.add('bg-ink');
    else header.classList.remove('bg-ink');
  };
  toggle.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));
  document.querySelectorAll('.mobile-link').forEach(link => link.addEventListener('click', () => setOpen(false)));
</script>
