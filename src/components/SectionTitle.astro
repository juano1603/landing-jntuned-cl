---
export interface Props {
  id: string;
  kicker: string;
  title: string;
}
const { id, kicker, title } = Astro.props;
---

<div class="mb-10 flex flex-wrap items-end justify-between gap-4 sm:mb-14">
  <div>
    <p class="mb-2 flex items-center gap-3 font-display text-sm font-semibold uppercase tracking-[0.3em] text-electric-bright">
      <span class="h-0.5 w-8 bg-electric-light" aria-hidden="true"></span>{kicker}
    </p>
    <h2 id={id} class="font-display text-4xl font-bold uppercase leading-none text-white sm:text-6xl">{title}</h2>
  </div>
  <slot />
</div>
