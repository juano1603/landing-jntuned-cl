---
import { Image } from 'astro:assets';
import type { Build } from '../data/builds';
import { foto } from '../lib/images';

export interface Props {
  build: Build;
}
const { build } = Astro.props;
const img = foto(build.foto);
---

<article class="group relative aspect-[4/5] overflow-hidden bg-ink-100 sm:aspect-[4/3] lg:aspect-[3/4]">
  {img ? (
    <Image
      src={img}
      widths={[480, 800, 1200]}
      sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
      alt={`${build.auto} ${build.motor} — ${build.tag} JNTUNED Temuco`}
      class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
    />
  ) : (
    <div class="absolute inset-0 flex items-center overflow-hidden bg-gradient-to-br from-ink-100 to-ink" aria-hidden="true">
      <span class="-ml-2 select-none font-display text-[7rem] font-bold uppercase leading-none text-white/[0.04]">
        {build.auto.split(' ')[0]}
      </span>
    </div>
  )}
  <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/40 to-transparent" aria-hidden="true"></div>

  <div class="absolute left-4 top-4 flex gap-2">
    {build.nuevo && (
      <span class="bg-electric px-2.5 py-1 font-display text-xs font-bold uppercase tracking-wider text-white">
        {typeof build.nuevo === 'string' ? build.nuevo : 'Nuevo'}
      </span>
    )}
    <span class="bg-ink/80 px-2.5 py-1 font-display text-xs font-semibold uppercase tracking-wider text-slate-200 backdrop-blur">
      {build.tag}
    </span>
  </div>

  <div class="absolute inset-x-0 bottom-0 p-5">
    <h3 class="font-display text-2xl font-bold uppercase leading-tight text-white">{build.auto}</h3>
    <p class="mt-1 text-sm text-slate-400">{build.motor}</p>
    <p class="mt-3 border-t border-white/10 pt-3 font-display text-lg font-semibold uppercase tracking-wide text-electric-bright">
      {build.resultado}
    </p>
  </div>
</article>
