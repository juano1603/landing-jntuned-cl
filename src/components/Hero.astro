---
import { Picture } from 'astro:assets';
import { SITE } from '../data/site';
import { foto } from '../lib/images';

const heroImg = foto('nissan-primera-p11-drag.jpg')!;

const stats = [
  { valor: '+150', label: 'ECUs calibradas' },
  { valor: '10.13 s', label: '1/8 de milla' },
  { valor: '100%', label: 'Con datalog' },
];
---

<section id="inicio" class="relative flex min-h-[92svh] flex-col justify-end overflow-hidden" aria-labelledby="hero-title">
  <Picture
    src={heroImg}
    formats={['avif', 'webp']}
    widths={[640, 1024, 1600, 2200]}
    sizes="100vw"
    alt="Nissan Primera P11 de JNTUNED acelerando en pista de drag"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 h-full w-full object-cover object-[60%_center]"
  />
  <div class="absolute inset-0 bg-gradient-to-r from-ink via-ink/70 to-ink/10" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-ink via-transparent to-ink/40" aria-hidden="true"></div>

  <div class="relative mx-auto w-full max-w-7xl px-4 pb-16 pt-32 sm:px-6 lg:px-8">
    <p class="mb-4 font-display text-sm font-semibold uppercase tracking-[0.3em] text-electric-bright">
      Temuco · Chile
    </p>
    <h1 id="hero-title" class="max-w-3xl font-display text-5xl font-bold uppercase leading-[0.95] text-white sm:text-7xl lg:text-8xl">
      Ingeniería aplicada <span class="text-electric-light">a tu motor</span>
    </h1>
    <p class="mt-5 max-w-md text-lg text-slate-300">
      Reprogramación de ECU, engine swaps y diagnóstico en Temuco.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href={SITE.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-electric px-7 py-3.5 font-display text-lg font-bold uppercase tracking-wider text-white transition-colors hover:bg-electric-light"
      >
        Cotizar proyecto
      </a>
      <a
        href="#builds"
        class="border border-white/30 px-7 py-3.5 font-display text-lg font-bold uppercase tracking-wider text-white transition-colors hover:border-white hover:bg-white hover:text-ink"
      >
        Ver builds
      </a>
    </div>

    <dl class="mt-14 grid max-w-xl grid-cols-3 gap-6 border-t border-white/15 pt-6">
      {stats.map(s => (
        <div>
          <dt class="sr-only">{s.label}</dt>
          <dd class="font-display text-3xl font-bold text-white sm:text-4xl">{s.valor}</dd>
          <dd class="mt-1 text-xs uppercase tracking-wider text-slate-400">{s.label}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
