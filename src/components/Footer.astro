---
import { SITE } from '../data/site';
---

<footer class="border-t border-white/10 px-4 py-10 sm:px-6 lg:px-8">
  <div class="mx-auto flex max-w-7xl flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex items-center gap-4">
      <img src="/logo-jntuned.png" alt="JNTUNED" width="120" height="23" loading="lazy" class="h-5 w-auto opacity-70" />
      <address class="text-xs not-italic text-slate-500">Temuco, Araucanía, Chile</address>
    </div>
    <div class="flex items-center gap-6 text-xs uppercase tracking-wider text-slate-500">
      <a href={SITE.instagram} target="_blank" rel="noopener noreferrer" class="hover:text-white">Instagram</a>
      <a href={SITE.whatsapp} target="_blank" rel="noopener noreferrer" class="hover:text-white">WhatsApp</a>
      <span>© {new Date().getFullYear()} JNTUNED</span>
    </div>
  </div>
</footer>
